cabal-version: 3.8
name: water-wars-client
version: 0.0.0
synopsis: Water Wars client library
homepage: https://github.com/FailWhaleBrigade/water-wars#readme
bug-reports: https://github.com/FailWhaleBrigade/water-wars/issues
author: Fendor, VeryMilkyJoe, Power-Fungus
maintainer: Fendor, VeryMilkyJoe, Power-Fungus
license: MIT
build-type: Simple

source-repository head
  type: git
  location: https://github.com/FailWhaleBrigade/water-wars

common options
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

    cpp-options:
      -DWASM

  if arch(javascript)
    ld-options:
      -sEXPORTED_RUNTIME_METHODS=HEAP8

library
  exposed-modules:
    WaterWars.Client.Codec.Resource
    WaterWars.Client.Network.Connection
    WaterWars.Client.Network.State
    WaterWars.Client.World
    WaterWars.Client.OptParse
    WaterWars.Client.Render.Animation
    WaterWars.Client.Render.Config
    WaterWars.Client.Render.Display
    WaterWars.Client.Render.State
    WaterWars.Client.Render.Terrain.Solid
    WaterWars.Client.Render.Update
    WaterWars.Client.Render.Utils
    WaterWars.Client.Resources.Block
    WaterWars.Client.Resources.Image
    WaterWars.Client.Resources.Resources

  other-modules:
    Paths_water_wars_client

  hs-source-dirs:
    src

  default-extensions:
    DeriveGeneric
    FlexibleContexts
    LambdaCase
    MonoLocalBinds
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables

  ghc-options:
    -Wall

  build-depends:
    -- classy-prelude,
    -- websockets,
    aeson,
    array,
    async,
    base,
    bytestring,
    containers,
    JuicyPixels,
    miso,
    monad-logger,
    mtl,
    optparse-applicative,
    stm,
    text,
    transformers,
    vector,
    water-wars,

  default-language: Haskell2010

executable water-wars-client
  import: options
  main-is: Main.hs
  other-modules:
    Paths_water_wars_client
    DOMRect

  hs-source-dirs:
    app

  default-extensions:
    FlexibleContexts
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables

  ghc-options:
    -Wall
    -rtsopts
    -O2
    -with-rtsopts=-N

  build-depends:
    array,
    base,
    miso,
    monad-logger,
    mtl,
    optparse-applicative,
    stm,
    transformers,
    vector,
    optics,
    water-wars ^>=0.0.0,
    water-wars-client,

  default-language: Haskell2010
