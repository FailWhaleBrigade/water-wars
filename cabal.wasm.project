packages:
         ./
         ./client/
         ./server/

package *
  ghc-options: -haddock

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  branch: 863bafa6bca730b5d45cfffcd6badcaa5f5f1a02

source-repository-package
  type: git
  location: https://github.com/haskell-wasm/network
  tag: ab92e48e9fdf3abe214f85fdbe5301c1280e14e9

with-compiler:
  wasm32-wasi-ghc

with-hc-pkg:
  wasm32-wasi-ghc-pkg

if arch(wasm32)
  -- Required for TemplateHaskell. When using wasm32-wasi-cabal from
  -- ghc-wasm-meta, this is superseded by the global cabal.config.
  shared: True

constraints:
  process ==1.6.26.1,

allow-newer: *:template-haskell, base
